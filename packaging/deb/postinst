#!/bin/sh
set -e

CONFIG=/etc/luradb/luradb.toml

case "$1" in
    configure)
        if ! getent passwd luradb >/dev/null 2>&1; then
            adduser --system --group --home /var/lib/luradb --no-create-home luradb
        fi

        chown root:luradb "$CONFIG"
        chmod 640 "$CONFIG"

        # Idempotent: only on first install is the placeholder still there; an
        # existing key stays untouched on upgrade/reinstall.
        if grep -q '@GENERATED_ON_INSTALL@' "$CONFIG"; then
            key="lura_$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
            sed -i "s/@GENERATED_ON_INSTALL@/$key/" "$CONFIG"
            # The placeholder comment no longer describes anything afterward — remove it.
            sed -i '/^# Placeholder/d' "$CONFIG"
        fi
    ;;
esac

