#!/bin/sh
set -e

CONFIG=/etc/luradb/luradb.toml

case "$1" in
    configure)
        if ! getent passwd luradb >/dev/null 2>&1; then
            adduser --system --group --home /var/lib/luradb --no-create-home luradb
        fi

        chown root:luradb "$CONFIG"
        chmod 640 "$CONFIG"

        # Holds the native HTTPS listener's cert/key (opt-in). Operator drops
        # files here; LuraDB itself never writes here.
        install -d -o root -g luradb -m 0750 /etc/luradb/tls

        # Idempotent: only on first install is the placeholder still there; an
        # existing key stays untouched on upgrade/reinstall.
        if grep -q '@GENERATED_ON_INSTALL@' "$CONFIG"; then
            key="lura_$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
            sed -i "s/@GENERATED_ON_INSTALL@/$key/" "$CONFIG"
            # The placeholder comment no longer describes anything afterward — remove it.
            sed -i '/^# Placeholder/d' "$CONFIG"
        fi

        # $2 (the previously configured version) is empty only on first install.
        if [ -z "$2" ]; then
            cat <<'EOF'

LuraDB is installed but not started.

  Config:  /etc/luradb/luradb.toml
  Data:    /var/lib/luradb
  Start:   sudo systemctl start luradb

Review the config before the first start (bind address, data paths, admin API key).
The service is enabled and starts automatically on the next boot.

EOF
        fi
    ;;
esac

